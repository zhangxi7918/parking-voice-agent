APP_ENV=production
PUBLIC_BASE_URL=https://voice-agent.example.com
DATABASE_PATH=/var/lib/parking-voice-agent/voice-agent.sqlite3
WECOM_WEBHOOK_URL=
NOTIFICATION_DRY_RUN=true

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VALIDATE_SIGNATURE=true

# Qwen / DashScope realtime voice
DASHSCOPE_API_KEY=
QWEN_REALTIME_MODEL=qwen-omni-turbo-realtime
