APP_ENV=production
DATABASE_PATH=/var/lib/parking-voice-agent/voice-agent.sqlite3
WECOM_WEBHOOK_URL=
NOTIFICATION_DRY_RUN=true

# LiveKit browser voice pipeline
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=parking-gatekeeper

# AI provider: openai or dashscope
VOICE_AGENT_AI_PROVIDER=openai
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_ASR_MODEL=qwen3-asr-flash
DASHSCOPE_LLM_MODEL=qwen-plus
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
